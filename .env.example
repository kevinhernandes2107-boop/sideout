# Copy this file to .env and fill in real values. .env is gitignored.

# Secret used to sign login JWTs. Any long random string is fine for local dev.
JWT_SECRET=change-me-to-something-random

# Gmail account used to send "forgot password" emails.
# GMAIL_ADDRESS is the full address, e.g. you@gmail.com
# GMAIL_APP_PASSWORD is a 16-character App Password, NOT your normal Gmail password.
# Generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the Google account first).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
